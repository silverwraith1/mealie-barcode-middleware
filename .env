# ── Barcode Lookup Sources ──────────────────────────────────────────
# OpenFoodFacts — free, no key needed, good EU coverage (enabled by default)
OFF_ENABLED=true
OFF_URL_BASE=https://world.openfoodfacts.org/api/v2/product/

# UPC Database — good US coverage, requires free API key (disabled by default)
UPCDB_ENABLED=false
UPCDB_URL_BASE=https://api.upcdatabase.org/product/
UPCDB_API_KEY=your-upcdatabase-api-key

# SparkyFitness — self-hosted nutritional & food database
SPARKYFITNESS_ENABLED=true
SPARKYFITNESS_URL_BASE=https://sparkyfit.donutholes.cc
SPARKYFITNESS_API_TOKEN=eDFxfhflEISJBLvCfmTjpdXGytXCdtOUHHNGZVWTxrzgyUJvSUcSJomJgHrLHNKAe

# ── Lookup Strategy ──────────────────────────────────────────────────
LOOKUP_PRIMARY=sparkyfitness
LOOKUP_STRATEGY=failover
LOOKUP_ENRICH_IN_BACKGROUND=true

# ── Matching & Sync ─────────────────────────────────────────────────
FUZZY_MATCH_THRESHOLD=85
FUZZY_AMBIGUITY_GAP=10
ITEM_SYNC_INTERVAL_HOURS=6
LOOKUP_TTL_DAYS=30
MAX_RETRY_ATTEMPTS=10

